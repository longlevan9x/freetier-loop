# Local Cloudflare Worker secrets & vars (copy to .dev.vars)
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=dev-only-better-auth-secret-please-change-in-prod-32b
ADMIN_EMAILS=admin@example.com
# Cloudflare Turnstile always-pass test secret key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 32-byte base64 key for AES-256-GCM encryption
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
REQUIRE_2FA=false
SELF_PROTECTED_HOSTS=localhost:8787

